# Normalize line endings across platforms (Windows/macOS contributors + CI).
* text=auto eol=lf

*.cs      text diff=csharp
*.md      text
*.json    text
*.yml     text
*.yaml    text

# Unity-specific (client/Game.Client). Uncomment once Git LFS is set up for
# binary assets (textures, audio, models, etc.) to keep the repo small.
# client/Game.Client/**/*.png filter=lfs diff=lfs merge=lfs -text
# client/Game.Client/**/*.psd filter=lfs diff=lfs merge=lfs -text
# client/Game.Client/**/*.fbx filter=lfs diff=lfs merge=lfs -text
# client/Game.Client/**/*.wav filter=lfs diff=lfs merge=lfs -text
# client/Game.Client/**/*.mp3 filter=lfs diff=lfs merge=lfs -text

# Unity .meta files must stay associated with their asset and use LF.
client/Game.Client/**/*.meta text merge=unityyamlmerge eol=lf
