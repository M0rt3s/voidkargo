@inject NavigationManager NavigationManager

@code {
    // Fires whenever <AuthorizeRouteView> hits a page's [Authorize] and the visitor isn't
    // authenticated (see Routes.razor). A normal HTTP redirect during static SSR — there's no
    // interactive circuit yet at this point, so NavigateTo just sets a Location header.
    protected override void OnInitialized()
    {
        var returnUrl = Uri.EscapeDataString(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        NavigationManager.NavigateTo($"/login?returnUrl=/{returnUrl}");
    }
}
